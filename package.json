{
  "name": "ensenameya",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:push": "npx supabase db push",
    "db:types": "npx supabase gen types typescript --linked > src/lib/database.types.ts.tmp && grep -q 'export type Database' src/lib/database.types.ts.tmp && mv src/lib/database.types.ts.tmp src/lib/database.types.ts || (rm -f src/lib/database.types.ts.tmp; echo '✗ db:types falló — database.types.ts NO se ha tocado'; exit 1)",
    "db:seed": "bash -c 'set -a; . ./.env.local; set +a; PATH=\"/opt/homebrew/opt/libpq/bin:$PATH\" psql \"$SUPABASE_DB_URL\" -v ON_ERROR_STOP=1 -f supabase/seed/dev-poblar.sql'",
    "db:seed:imagenes": "node supabase/seed/dev-imagenes.mjs",
    "check:email": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/lib/email-templates.check.ts",
    "check:terms": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/components/legal/terms-content.check.ts",
    "check:ics": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/lib/calendar/ics-format.check.ts",
    "check:chat": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/lib/chat/limits.check.ts"
  },
  "dependencies": {
    "@daily-co/daily-js": "^0.91.0",
    "@sentry/nextjs": "^10.69.0",
    "@stripe/react-stripe-js": "^6.8.1",
    "@stripe/stripe-js": "^9.13.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.5.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-phone-number-input": "^3.4.17",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "stripe": "^22.4.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
