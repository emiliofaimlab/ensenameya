{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/recordings-purge",
      "schedule": "0 4 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "ensenameya.com" }],
      "destination": "/contacto",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.ensenameya.com" }],
      "destination": "/contacto",
      "permanent": false
    }
  ]
}
