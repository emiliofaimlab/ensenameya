# ============================================================================
# Variables de entorno — Enséñame Ya
# Copia este archivo a `.env.local` y rellena los valores.
#   cp .env.example .env.local
# ============================================================================

# ── Supabase ────────────────────────────────────────────────────────────────
# PÚBLICAS (NEXT_PUBLIC_*): viajan al navegador. La ANON key es pública a
# propósito; queda sujeta a RLS (Doc 3). No expone nada por sí sola.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=pega-aqui-la-anon-key-de-`supabase start`

# SECRETA: SOLO servidor (Edge Functions / scripts). Se SALTA RLS por completo.
# NUNCA la pongas en una variable NEXT_PUBLIC_* ni la subas al repo.
SUPABASE_SERVICE_ROLE_KEY=pega-aqui-la-service_role-key-de-`supabase start`

# ── Producción / Staging ─────────────────────────────────────────────────────
# Reemplaza por los valores del proyecto en https://supabase.com
# (Project Settings → API). Un proyecto distinto por ambiente.
# NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...
